# The same project the app uses. Both are public values: the anon key is
# designed to sit in a browser, and every table this tool reads is behind
# RLS plus the admin check in supabase/functions/admin.
#
# The service_role key does NOT belong here, or anywhere a browser can
# reach. If you find yourself pasting it into this file, something has
# gone wrong — the Edge Function holds it, on the server.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
