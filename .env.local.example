VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Crash reporting (LAUNCH-CHECKLIST §10). Leave it out and Sentry is not
# loaded at all — the app runs exactly as it does today. Set it and crashes
# from ErrorBoundary are reported, scrubbed by src/lib/crashReporting.ts.
# VITE_SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>
